<Project Sdk="Aspire.AppHost.Sdk/13.1.0">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>a2b33d8d-ff44-4cc6-929e-64fb3fd72f46</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SampleApi\SampleApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <SharedResourceReference Include="sample-api">
      <Name>SampleApi</Name>
      <ContainerImage>sample-api</ContainerImage>
      <ContainerTag>latest</ContainerTag>
      <Mode>Project</Mode>
      <ProjectPath>..\SampleApi\SampleApi.csproj</ProjectPath>
      <BuildImageCommand>dotnet publish --os linux --arch x64 /t:PublishContainer</BuildImageCommand>
    </SharedResourceReference>
  </ItemGroup>

</Project>
